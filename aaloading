				end
			end
			task.wait(0.28)
		end
	end)

	guard(function()
		while still() do
			scan.Position = UDim2.fromScale(0, -0.2)
			local sweep = TweenService:Create(scan, TweenInfo.new(2.8, Enum.EasingStyle.Linear), {
				Position = UDim2.fromScale(0, 1.05),
			})
			sweep:Play()
			sweep.Completed:Wait()
		end
	end)

	task.delay(math.max(0.2, HOLD - FADE), function()
		if not still() then
			return
		end
		closing = true
		local out = TweenService:Create(reveal, TweenInfo.new(FADE, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Value = 0,
		})
		out.Completed:Connect(function()
			if gui.Parent then
				gui:Destroy()
			end
		end)
		out:Play()
	end)
end, debug.traceback)

if not built then
	warn("[ScriptLoader] " .. tostring(buildErr))
	if gui.Parent then
		gui:Destroy()
	end
end
