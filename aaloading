		Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=420&h=420", player.UserId),
		ScaleType = Enum.ScaleType.Crop,
		ResampleMode = Enum.ResamplerMode.Default,
		ZIndex = 9,
		Parent = profile,
	})
	new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = avatar })
	track(avatar, "ImageTransparency", 0)
	local avatarStroke = new("UIStroke", {
		Thickness = 2,
		Color = CYAN,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = avatar,
	})
	track(avatarStroke, "Transparency", 0)

	local displayName = player.DisplayName
	if displayName == "" then
		displayName = player.Name
	end

	label({
		Position = UDim2.fromOffset(116, 24),
		Size = UDim2.new(1, -136, 0, 16),
		TextSize = 13,
		TextColor3 = MAGENTA,
