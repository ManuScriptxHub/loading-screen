-- Duality loading screen. Stays up for 40 seconds, then fades out.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local DURATION = 40
local WORD = "SCRIPT LOADER"
local SUB = "P L E A S E  W A I T .   L O A D I N G D A T A ."

local B64 = [[]]

local player = Players.LocalPlayer
local parent = nil
pcall(function()
	parent = gethui()
end)
if not parent then
	parent = player:WaitForChild("PlayerGui")
end

local old = parent:FindFirstChild("DualityLoading")
if old then
	old:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "DualityLoading"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 100000
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = parent

if typeof(STATE) == "table" and typeof(STATE.onCleanup) == "function" then
	STATE.onCleanup(function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
end

local function alive()
	return gui.Parent ~= nil
end

local root = Instance.new("Frame")
root.Name = "Backdrop"
root.Size = UDim2.fromScale(1, 1)
root.BackgroundColor3 = Color3.new(0, 0, 0)
root.BackgroundTransparency = 0.7   -- add this line
root.BorderSizePixel = 0
root.Active = true
root.Parent = gui

local function applyFace(label, weight)
	local ok = pcall(function()
		label.FontFace = Font.new(
			"rbxasset://fonts/families/GothamSSm.json",
			weight,
			Enum.FontStyle.Normal
		)
	end)
	if not ok then
		label.Font = Enum.Font.GothamBold
	end
end

local function corner(px, py, ax, ay)
	local col = Color3.fromRGB(176, 176, 176)
	local function bar()
		local f = Instance.new("Frame")
		f.BackgroundColor3 = col
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.AnchorPoint = Vector2.new(ax, ay)
		f.Position = UDim2.fromScale(px, py)
		f.Parent = root
		return f
	end
	local h = bar()
	local v = bar()
	return h, v
end

local brackets = {
	{ corner(0.055, 0.09, 0, 0) },
	{ corner(0.945, 0.09, 1, 0) },
	{ corner(0.055, 0.91, 0, 1) },
	{ corner(0.945, 0.91, 1, 1) },
}

local logoHolder = Instance.new("Frame")
