	local trackBar = new("Frame", {
		Name = "Track",
		Position = UDim2.fromOffset(28, 142),
		Size = UDim2.new(1, -56, 0, 10),
		BackgroundColor3 = Color3.fromRGB(54, 40, 84),
		BorderSizePixel = 0,
		ZIndex = 8,
		Parent = card,
	})
	new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = trackBar })
	track(trackBar, "BackgroundTransparency", 0)

	local fill = new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 9,
		Parent = trackBar,
	})
	new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
	new("UIGradient", { Color = ColorSequence.new(MAGENTA, CYAN), Parent = fill })
	track(fill, "BackgroundTransparency", 0)

	local percent = label({
		Name = "Percent",
		Position = UDim2.fromOffset(28, 162),
		Size = UDim2.new(0.5, -28, 0, 20),
		TextSize = 15,
		Text = "00%",
		Parent = card,
	}, "mono")

	local clock = label({
		Name = "Clock",
		Position = UDim2.new(0.5, 0, 0, 162),
		Size = UDim2.new(0.5, -28, 0, 20),
		TextSize = 15,
		TextColor3 = MUTED,
