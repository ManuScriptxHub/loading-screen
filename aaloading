		Parent = profile,
	}, "mono")
	label({
		Position = UDim2.fromOffset(116, 44),
		Size = UDim2.new(1, -136, 0, 28),
		TextSize = 24,
		Text = displayName,
		Parent = profile,
	}, "bold")
	label({
		Position = UDim2.fromOffset(116, 76),
		Size = UDim2.new(1, -136, 0, 20),
		TextSize = 15,
		TextColor3 = CYAN,
		Text = "@" .. player.Name,
		Parent = profile,
	}, "mono")

	local phases = {
		{ 0.00, "INITIALIZING LOADER" },
		{ 0.16, "SYNCING OPERATOR" },
		{ 0.38, "CHARGING NEON CORE" },
		{ 0.58, "DECRYPTING MODULES" },
		{ 0.78, "LOCKING SIGNAL" },
		{ 0.94, "VESPERHUB ONLINE" },
	}

	local progress = new("NumberValue", {
		Name = "Progress",
		Value = 0,
		Parent = gui,
	})
	progress.Changed:Connect(function(value)
		if fill.Parent == nil then
			return
		end
		local alpha = math.clamp(value, 0, 1)
		fill.Size = UDim2.fromScale(alpha, 1)
		percent.Text = string.format("%02d%%", math.floor(alpha * 100 + 0.5))
		local line = phases[1][2]
		for _, phase in phases do
			if alpha >= phase[1] then
				line = phase[2]
			end
		end
		status.Text = line
	end)

	local reveal = new("NumberValue", {
		Name = "Reveal",
		Value = 0,
		Parent = gui,
	})
	applyFade(0)
	reveal.Changed:Connect(applyFade)

	local started = os.clock()
	TweenService:Create(reveal, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Value = 1,
	}):Play()
	TweenService:Create(card, TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
