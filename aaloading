	}):Play()
	TweenService:Create(progress, TweenInfo.new(HOLD, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Value = 1,
	}):Play()

	local function guard(fn)
		task.spawn(function()
			local ok, err = pcall(fn)
			if not ok then
				warn("[ScriptLoader] " .. tostring(err))
			end
		end)
	end

	guard(function()
		while still() do
			local left = math.max(0, HOLD - (os.clock() - started))
			clock.Text = string.format("%02d:%02d", math.floor(left / 60), math.floor(left % 60))
			task.wait(0.1)
		end
	end)

	guard(function()
		while still() do
			for _, bar in bars do
				if bar.Parent then
					TweenService:Create(bar, TweenInfo.new(0.26, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
						Size = UDim2.fromOffset(8, math.random(8, 30)),
