		Parent = card,
	}, "mono")

	local rule = new("Frame", {
		Position = UDim2.fromOffset(28, 196),
		Size = UDim2.new(1, -56, 0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 8,
		Parent = card,
	})
	track(rule, "BackgroundTransparency", 0.82)

	local profile = new("Frame", {
		Name = "Profile",
		Position = UDim2.fromOffset(20, 214),
		Size = UDim2.new(1, -40, 0, 122),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		ZIndex = 8,
		Parent = card,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 12), Parent = profile })
	track(profile, "BackgroundTransparency", 0.94)

	local avatar = new("ImageLabel", {
		Name = "Avatar",
		Position = UDim2.fromOffset(20, 22),
