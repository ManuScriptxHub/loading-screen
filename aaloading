applyFace(percent, Enum.FontWeight.Regular)

local function layout()
	local cam = workspace.CurrentCamera
	local vs = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local arm = math.clamp(math.floor(vs.Y * 0.028), 16, 34)
	local thick = math.max(1, math.floor(vs.Y * 0.0016))
	for _, pair in ipairs(brackets) do
		pair[1].Size = UDim2.fromOffset(arm, thick)
		pair[2].Size = UDim2.fromOffset(thick, arm)
	end
	logoHolder.Size = UDim2.fromOffset(math.clamp(math.floor(vs.X * 0.24), 220, 460), 80)
	title.TextSize = math.clamp(math.floor(vs.Y * 0.052), 30, 56)
	title.Size = UDim2.new(0.7, 0, 0, math.floor(title.TextSize * 1.25))
	subtitle.TextSize = math.clamp(math.floor(vs.Y * 0.0165), 11, 16)
	subtitle.Position = UDim2.new(0.5, 0, 0.575, math.floor(title.TextSize * 1.15))
	percent.TextSize = math.clamp(math.floor(vs.Y * 0.015), 10, 14)
	local barW = math.clamp(math.floor(vs.X * 0.145), 168, 300)
	local barH = math.max(2, math.floor(vs.Y * 0.0035))
	track.Size = UDim2.fromOffset(barW, barH)
	local lineW = math.clamp(math.floor(vs.X * 0.105), 70, 180)
	leftLine:SetAttribute("TargetW", lineW)
	rightLine:SetAttribute("TargetW", lineW)
end

layout()
local cam = workspace.CurrentCamera
if cam and typeof(STATE) == "table" and typeof(STATE.connect) == "function" then
	STATE.connect(cam:GetPropertyChangedSignal("ViewportSize"), layout)
end

local started = os.clock()
local dismissed = false
local linesShown = false

local function fadeBrackets(info, value)
	for _, pair in ipairs(brackets) do
		TweenService:Create(pair[1], info, { BackgroundTransparency = value }):Play()
		TweenService:Create(pair[2], info, { BackgroundTransparency = value }):Play()
	end
end

local function dismiss()
	if dismissed or not alive() then
		return
	end
	dismissed = true
	local info = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(root, info, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(logo, info, { ImageTransparency = 1 }):Play()
	TweenService:Create(glow, info, { ImageTransparency = 1 }):Play()
	TweenService:Create(sheen, info, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(leftLine, info, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(rightLine, info, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(title, info, { TextTransparency = 1 }):Play()
	TweenService:Create(subtitle, info, { TextTransparency = 1 }):Play()
	TweenService:Create(track, info, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(fill, info, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(percent, info, { TextTransparency = 1 }):Play()
	fadeBrackets(info, 1)
	task.delay(0.75, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
end

local intro = TweenInfo.new(0.85, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
TweenService:Create(logo, intro, { ImageTransparency = 0 }):Play()
TweenService:Create(glow, intro, { ImageTransparency = 0.62 }):Play()
fadeBrackets(TweenInfo.new(0.7), 0.28)

task.spawn(function()
	while alive() and not dismissed do
		local t = os.clock() - started
		if t > 0.85 and not linesShown then
			linesShown = true
			local w = leftLine:GetAttribute("TargetW") or 120
			local grow = TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(leftLine, grow, { Size = UDim2.fromOffset(w, 1) }):Play()
			TweenService:Create(rightLine, grow, { Size = UDim2.fromOffset(w, 1) }):Play()
		end
		if t >= 1.15 and title.Text ~= WORD then
			local n = math.clamp(math.floor((t - 1.15) / 0.12) + 1, 1, #WORD)
			title.Text = string.sub(WORD, 1, n)
		end
		if t >= 2.15 and subtitle.TextTransparency > 0.05 then
			TweenService:Create(subtitle, TweenInfo.new(0.4), { TextTransparency = 0.05 }):Play()
			TweenService:Create(track, TweenInfo.new(0.35), { BackgroundTransparency = 0 }):Play()
			TweenService:Create(fill, TweenInfo.new(0.35), { BackgroundTransparency = 0 }):Play()
			TweenService:Create(percent, TweenInfo.new(0.35), { TextTransparency = 0.1 }):Play()
		end
		local p = math.clamp(t / DURATION, 0, 1)
		local eased = p * p * (3 - 2 * p)
		fill.Size = UDim2.fromScale(eased, 1)
		percent.Text = string.format("%d%%", math.floor(eased * 100 + 0.5))
		if t >= DURATION then
			dismiss()
			break
		end
		task.wait(0.03)
	end
end)

task.spawn(function()
	task.wait(0.35)
	while alive() and not dismissed and (os.clock() - started) < 9 do
		sheen.Position = UDim2.fromScale(-0.45, 0.5)
		local tw = TweenService:Create(
			sheen,
			TweenInfo.new(1.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Position = UDim2.fromScale(1.45, 0.5) }
		)
		tw:Play()
		tw.Completed:Wait()
		task.wait(1.6)
	end
	if alive() then
		sheen.BackgroundTransparency = 1
	end
end)

if not wrote or asset == "" then
	warn("[DualityLoading] logo image failed to load")
end
