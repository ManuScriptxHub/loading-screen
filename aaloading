local function makeLine(x, anchorX)
	local line = Instance.new("Frame")
	line.AnchorPoint = Vector2.new(anchorX, 0.5)
	line.Position = UDim2.fromScale(x, 0.545)
	line.Size = UDim2.fromOffset(0, 1)
	line.BackgroundColor3 = Color3.fromRGB(214, 214, 214)
	line.BackgroundTransparency = 0.2
	line.BorderSizePixel = 0
	line.Parent = root
	return line
end

local leftLine = makeLine(0.458, 1)
local rightLine = makeLine(0.542, 0)

